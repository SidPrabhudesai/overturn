# Meta Model API (OpenAI-compatible). Create a key in the Model API dashboard.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1

# Verify the exact model id for your account (docs mention muse-spark-1.1 / 1.2 / 1.3).
MODEL=muse-spark-1.2
# minimal | low | medium | high | xhigh  (lower = faster, cheaper; WhatsApp replies need to be quick)
REASONING_EFFORT=low

# NEVER use a "-contributor" model for real users' health messages: that tier lets Meta train on
# prompts. It is fine for the synthetic eval claims; opt in explicitly with:
# ALLOW_CONTRIBUTOR_TIER=1

# local = search corpus/corpus.jsonl (build it with scripts/build_corpus.py)
# web   = Meta Responses API web_search tool (UNTESTED against Meta's API)
RETRIEVER=local

# --- Twilio WhatsApp (optional) ---
# Set both to verify that webhook calls really come from Twilio.
TWILIO_AUTH_TOKEN=
PUBLIC_URL=https://YOUR-NGROK-SUBDOMAIN.ngrok-free.app
# Set these three to reply asynchronously (recommended: Twilio drops webhooks that take >15s).
TWILIO_ACCOUNT_SID=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
